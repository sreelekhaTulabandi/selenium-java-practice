<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<suite name="Selenium Parallel Practice Suite" parallel="methods" thread-count="3" verbose="1">
    <listeners>
        <listener class-name="listeners.ExtentReportListener"/>
    </listeners>
    <test name="Thread-safe browser sessions">
        <classes>
            <class name="parallel.ParallelBrowserTest"/>
        </classes>
    </test>
</suite>